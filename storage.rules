rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Public Read Access for website image rendering
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. Student Photos Upload (Max 100 KB limit & Image types only)
    match /students/photos/{fileName} {
      allow write: if request.resource.size <= 100 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 3. DigiLocker Document Upload (Max 100 KB limit & Image/PDF only)
    match /locker/{studentId}/{fileName} {
      allow write: if request.resource.size <= 100 * 1024
                   && (request.resource.contentType.matches('image/.*') 
                       || request.resource.contentType == 'application/pdf');
    }

    // 4. Mark List Upload (Max 100 KB limit & Image/PDF only)
    match /marksheets/{academicYear}/{fileName} {
      allow write: if request.resource.size <= 100 * 1024
                   && (request.resource.contentType.matches('image/.*') 
                       || request.resource.contentType == 'application/pdf');
    }

    // Fallback: Default path uploads (Max 100 KB limit)
    match /uploads/{fileName} {
      allow write: if request.resource.size <= 100 * 1024;
    }
  }
}
