# Environment Variables for Yatheem Care System

# === Storage Provider ===
# Options: local | firebase | s3
# 'local' = zero-cost local disk storage (default for development)
STORAGE_PROVIDER=local

# === JWT Secret — CHANGE THIS IN PRODUCTION! ===
JWT_SECRET=yatheemcare_super_secret_jwt_key_change_in_production_2026

# === Database ===
# SQLite (development):
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/yatheemcare?schema=public"

# === Firebase Storage (required only if STORAGE_PROVIDER=firebase) ===
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# === AWS S3 / MinIO (required only if STORAGE_PROVIDER=s3) ===
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=yatheemcare-storage-bucket
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# === Next.js Public ===
NEXT_PUBLIC_STORAGE_PROVIDER=local
NEXT_PUBLIC_APP_NAME=Yatheem Care
